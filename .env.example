# Copy to .env (git-ignored) and fill in. Only the providers you route to are needed.
VISION_PROVIDER_API_KEY=
TEXT_PROVIDER_API_KEY=
LITELLM_MASTER_KEY=

# Client side: run.py / billx.extract talk to the gateway
GATEWAY_BASE_URL=http://127.0.0.1:4000
GATEWAY_API_KEY=
EXTRACT_MODEL=vision-default

# Cost tracker
TRACKER_DB_PATH=gateway/tracker.db
TRACKER_BUDGET_USD=50
TRACKER_INPUT_USD_PER_M=2.00
TRACKER_CACHED_INPUT_USD_PER_M=0.20
TRACKER_OUTPUT_USD_PER_M=10.00
# Optional per-model / per-alias prices (see gateway/prices.example.json)
TRACKER_PRICES_FILE=
